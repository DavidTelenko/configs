[user]
  name = David Telenko
  email = davidtelenko11@gmail.com
[credential "helperselector"]
  selected = manager
[credential "https://github.com"]
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper = !gh auth git-credential
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[core]
  autocrlf = false
  editor = nvim
  eol = lf
  symlinks = true
  longpaths = true
	pager = nvim -R -c 'set ft=git'
[color]
	pager = no
[merge]
  conflictstyle = diff3
[difftool "nvim_difftool"]
  cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  tool = nvim_difftool
[rerere]
  enabled = true
[init]
  defaultBranch = main
[http]
  ; postBuffer = 157286400
  ; sslBackend = openssl
[sendpack]
  sideband = false
[alias]
  unstage = reset HEAD --
  last = log -1 HEAD
  lol = log --oneline --graph --all
  ambient-pull = !git stash && git switch $1 && git pull && git switch - && git stash pop && :
  pushf = push --force-with-lease
[pull]
  rebase = true
[push]
  autoSetupRemote = true
  default = current
  followTags = true
[fetch]
  prune = true
  ; pruneTags = true
[branch]
  sort = -committerdate
[help]
  autocorrect = prompt
[commit]
  verbose = true
[column]
  ui = auto
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
